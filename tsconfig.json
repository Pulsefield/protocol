{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["tools/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
  "exclude": ["gen", "node_modules"]
}
